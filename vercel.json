{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{.checkouts/**,.publish/**,.tools/**,.venv/**,.vercel/**,**/__pycache__/**,**/*.pyc,vercel-setup.zip}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
